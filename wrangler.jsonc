{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webcv",
	"compatibility_date": "2026-09-11",
	// Static assets only. The site is a Next.js export built to ./out, so
	// there is no Worker script, no OpenNext runtime, no self-reference
	// binding and no image binding -- and, more to the point, no request-time
	// dependency on cms.burbn.de. burbn.de now stays up when the homelab does
	// not, which is the reason for the change.
	"assets": {
		"directory": "./out"
	}
}
